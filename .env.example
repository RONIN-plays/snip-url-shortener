# Copy to .env and change the secrets. Never commit .env.
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
DATABASE_URL=postgresql://shortener:change-me@db:5432/shortener

# Public base used when building short links, e.g. https://short.example.com
BASE_URL=http://localhost:8000

# Secret key for the ID scrambler (see app/idgen.py). Changing it changes every future code.
ID_SECRET=change-me-to-a-long-random-string

REDIS_URL=redis://redis:6379/0

# Secret for signing login tokens (JWT)
JWT_SECRET=change-me-too-long-random-string
